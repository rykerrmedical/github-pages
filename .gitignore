# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

node_modules/

# Search indexer (rykerr-search project) — build artifacts, not source
search-indexer/venv/
search-indexer/venv312/
search-indexer/__pycache__/
search-indexer/*.db
search-indexer/build_log_*.txt
_to_delete/

# Search indexer scratch/backups -- never push these (the live index is built in CI;
# a single backup is >100 MB and GitHub rejects the whole push)
search-indexer/*.db.*
search-indexer/*.db-journal
search-indexer/*.db-wal
search-indexer/*.db-shm
search-indexer/*.bak
search-indexer/*.bak_*
search-indexer/toc_probe_out.json
search-indexer/pdf-probe/
pdf-probe/
*.bak
*.bak_*
